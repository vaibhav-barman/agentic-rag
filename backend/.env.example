# Copy to backend/.env and fill in. Never commit backend/.env.

# --- Supabase (Project Settings -> API / JWT Keys) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
# Legacy HS256 JWT secret. Leave EMPTY if your project uses asymmetric JWT
# signing keys (the default for new projects); tokens are then verified
# against SUPABASE_URL/auth/v1/.well-known/jwks.json.
SUPABASE_JWT_SECRET=

# --- Google Gemini API (key from https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Chat model must support tool calling.
GEMINI_MODEL=gemini-2.5-flash
# Shortened to 1024 dims automatically to match the database.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- LangSmith ---
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=agentic-rag
LANGSMITH_TRACING=true

# --- CORS (comma-separated browser origins) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
