# Copy to backend/.env and fill in. Never commit backend/.env.

# --- Supabase (Project Settings -> API / JWT Keys) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
# Legacy HS256 JWT secret. Leave EMPTY if your project uses asymmetric JWT
# signing keys (the default for new projects); tokens are then verified
# against SUPABASE_URL/auth/v1/.well-known/jwks.json.
SUPABASE_JWT_SECRET=

# --- OpenRouter (OpenAI-compatible API) ---
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4.1-mini

# --- LangSmith ---
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=agentic-rag
LANGSMITH_TRACING=true

# --- CORS (comma-separated browser origins) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
