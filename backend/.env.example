# Copy to backend/.env and fill in. Never commit backend/.env.

# --- Supabase (Project Settings -> API / JWT Keys) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
# Legacy HS256 JWT secret. Leave EMPTY if your project uses asymmetric JWT
# signing keys (the default for new projects); tokens are then verified
# against SUPABASE_URL/auth/v1/.well-known/jwks.json.
SUPABASE_JWT_SECRET=
# Postgres connection string (Connect -> Session pooler). Only used by
# scripts/apply_migrations.py to apply supabase/migrations/*.sql.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres

# --- Google Gemini API (key from https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Chat model must support tool calling.
GEMINI_MODEL=gemini-flash-lite-latest
# Shortened to 1024 dims automatically to match the database.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Retrieval (Modules 2, 6) ---
# hybrid = keyword + vector fused with RRF; or "vector" / "keyword" to compare.
SEARCH_MODE=hybrid
# Chunks fetched from the database before reranking keeps FILE_SEARCH_TOP_K of them.
RETRIEVAL_CANDIDATES=20
FILE_SEARCH_TOP_K=5
# An extra Gemini call per search that re-orders the candidates (0-1 relevance).
RERANK_ENABLED=true
RERANK_MIN_SCORE=0.2
# Vector-only search drops chunks below this cosine similarity.
RETRIEVAL_MIN_SIMILARITY=0.3

# --- Ingestion (Modules 4, 5) ---
# docling (layout-aware PDF/DOCX/HTML) or basic (pypdf / python-docx / BeautifulSoup).
DOCUMENT_PARSER=docling
# One Gemini call per document to extract title, type, topics, summary.
METADATA_EXTRACTION_ENABLED=true

# --- Tools (Module 7) ---
# Web search fallback (https://tavily.com). Leave empty to disable the tool.
TAVILY_API_KEY=

# --- Sub-agent (Module 8) ---
# Larger documents are shown to the sub-agent in part; it reads the rest with its tools.
SUBAGENT_MAX_CHARS=400000

# --- LangSmith ---
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=agentic-rag
LANGSMITH_TRACING=true

# --- CORS (comma-separated browser origins) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
